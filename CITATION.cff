  # academic attribution; "SK000001" is the GitHub handle placeholder.
  - name: "SK000001"
version: "1.0.0"
date-released: "2026-06-05"
url: "https://tern-pi.vercel.app"
repository-code: "https://github.com/SK000001/tritlogic"
